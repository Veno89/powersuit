# Assets, Packages, ProjectSettings, and every source asset .meta file are tracked.

# Supplied iteration quarantine; curated source/provenance lives in ArtSource.
/OtherIterations/

# Blender authoring pipeline local/generated state
/ArtSource/**/__pycache__/
/ArtSource/**/*.py[cod]
/ArtSource/**/*.blend[1-9]
/ArtSource/**/blender_path.txt
/ArtSource/**/renders/
/ArtSource/**/exports/

# Small, curated NextGen visual-development renders are review evidence. Keep
# the exceptions candidate-specific so future large render sets remain ignored.
!/ArtSource/PoweredSuitNextGen/renders/
!/ArtSource/PoweredSuitNextGen/renders/aegis_vanguard_blockout_v001/
!/ArtSource/PoweredSuitNextGen/renders/aegis_vanguard_blockout_v001/*.png
!/ArtSource/PoweredSuitNextGen/renders/aegis_vanguard_blockout_v002/
!/ArtSource/PoweredSuitNextGen/renders/aegis_vanguard_blockout_v002/*.png
!/ArtSource/PoweredSuitNextGen/renders/aegis_vanguard_candidate_v003/
!/ArtSource/PoweredSuitNextGen/renders/aegis_vanguard_candidate_v003/*.png
!/ArtSource/PoweredSuitNextGen/renders/aegis_vanguard_candidate_v004/
!/ArtSource/PoweredSuitNextGen/renders/aegis_vanguard_candidate_v004/*.png

